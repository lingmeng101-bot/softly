# 复制成 .env 后按本机情况改（.env 不会进 git）
# Clash Verge 混合端口（设置 → 端口设置）
PROXY_HTTP=http://127.0.0.1:7897
# 可选：socks5 口，只有需要 UDP/QUIC 时才用
# PROXY_SOCKS=socks5://127.0.0.1:7891
# Clash 外部控制器（设置 → 外部控制）
CLASH_API=http://127.0.0.1:9097
CLASH_SECRET=
# 换节点用的策略组名，填 Clash 里实际的主选择组
CLASH_GROUP=🚀 节点选择

# 需要人工完成人机验证的站点（可选）：复用浏览器会话，不做 JS 绕过
# HTTP_COOKIE=cf_clearance=...; 其他cookie=...
# HTTP_USER_AGENT=与过验证时一致的浏览器 UA
# PLAYWRIGHT_STORAGE_STATE=data/session.json
# 目标级并发（默认 1 = 顺序；并发时每个目标独立 SQLite 连接）
# MAX_CONCURRENT_TARGETS=4
